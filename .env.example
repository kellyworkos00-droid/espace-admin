# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project shared with the mobile app.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=

# Required for admin writes so actions are not blocked by row-level security.
# Supabase dashboard -> Project Settings -> API -> service_role.
# Server-side only. Never expose this to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# Console sign-in. Sign-in stays disabled until both are set.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=

# Infobip 2FA for phone verification. Server-side only.
INFOBIP_BASE_URL=https://yourid.api.infobip.com
INFOBIP_API_KEY=
INFOBIP_2FA_APPLICATION_ID=
INFOBIP_2FA_MESSAGE_ID=
